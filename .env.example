# ==============================================================================
# Tank Artillery Web — PeerJS 信令與 ICE/TURN 伺服器環境變數範例
# 若未設定 VITE_PEER_HOST，前端預設自動使用 PeerJS 官方免費公共信令伺服器
# ==============================================================================

# 1. 自建輕量 PeerJS 信令伺服器設定 (對應 ./server 或 docker-compose.yml)
# VITE_PEER_HOST=localhost
# VITE_PEER_PORT=9000
# VITE_PEER_PATH=/signaling
# VITE_PEER_SECURE=false
# VITE_PEER_KEY=peerjs

# 房間列表 API 路徑（預設 /rooms）。只有設定了 VITE_PEER_HOST 才會啟用房間列表；
# 使用公共信令伺服器時沒有這個功能，大廳會改成只能輸入房號加入。
# VITE_ROOMS_PATH=/rooms

# 若設定為 true（預設），當自建信令伺服器離線或無法連線時，將自動平滑回退至官方公共池
# VITE_PEER_FALLBACK_PUBLIC=true

# 2. 進階 ICE / STUN / TURN 擴充設定 (選填，供嚴格對稱型 NAT 網路環境使用)
# 可填入額外 STUN URL（以逗號分隔）
# VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# 可填入 TURN 伺服器設定
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=tankuser
# VITE_TURN_CREDENTIAL=tanksecret
